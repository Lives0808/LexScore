# LexScore 支持的模型接入配置
#
# 不填任何配置也能跑：默认使用内置的规则评分器（rule-engine v1），
# 所有分析都在本地完成，不需要网络请求，也不需要 API Key。
#
# 想让批改的措辞更自然、改写建议更灵活，可以接入任意 OpenAI 兼容接口。
# 服务器会自动检测：配置了 KEY 就走模型，模型调用失败会自动回退到规则评分器。

# 接口地址（去掉结尾斜杠）
LEXSCORE_LLM_BASE_URL=https://api.openai.com/v1

# API Key。留空则使用规则评分器
LEXSCORE_LLM_API_KEY=

# 模型名。国内可选 deepseek-chat / qwen-plus / doubao-pro 等
LEXSCORE_LLM_MODEL=gpt-4o-mini

# 单次批改的超时时间（毫秒）
LEXSCORE_LLM_TIMEOUT_MS=90000
