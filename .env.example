# LexScore 模型接入配置（可选）
#
# ⚠️ 重要：应用现在是静态导出，客户端（浏览器 / 安卓 App）没有服务端。
#    这个文件只在 Node 环境下有效（例如你自己加回一个服务端路由，或写脚本调用）。
#    浏览器与安卓端一律使用内置的规则评分器 —— 这是刻意设计：
#    API Key 一旦打进客户端产物，任何人都能从 APK 里解出来。
#
# 不填任何配置也能跑：默认使用规则评分器（rule-engine v1），
# 所有分析都在本地完成，不需要网络请求，也不需要 API Key。

# 接口地址（去掉结尾斜杠）
LEXSCORE_LLM_BASE_URL=https://api.deepseek.com/v1

# API Key。留空则使用规则评分器
LEXSCORE_LLM_API_KEY=

# 模型名。国内可选 deepseek-chat / qwen-plus / doubao-pro 等
LEXSCORE_LLM_MODEL=deepseek-chat

# 单次批改的超时时间（毫秒）
LEXSCORE_LLM_TIMEOUT_MS=90000
