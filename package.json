{
  "name": "lexscore",
  "version": "0.3.1",
  "private": true,
  "description": "雅思 / 托福写作批改：四维评分对齐、逐句对照式批注、扣题度诊断与反模板检测、个人写作语料库",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.tsx\" \"lib/**/*.ts\" \"scripts/**/*.{ts,tsx}\" \"*.ts\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.tsx\" \"lib/**/*.ts\" \"scripts/**/*.{ts,tsx}\" \"*.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:engine && npm run verify:ui",
    "verify:engine": "tsx scripts/verify.ts",
    "verify:ui": "tsx scripts/render-check.tsx",
    "verify:static": "node scripts/verify-static.mjs",
    "preview": "tsx scripts/build-preview.tsx",
    "icons": "node scripts/generate-icons.mjs",
    "android:apk": "./scripts/build-android.sh release",
    "android:debug": "./scripts/build-android.sh debug",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
